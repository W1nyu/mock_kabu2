[Unit]
Description=mock-kabu2 → Oracle Autonomous Database archive sync
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/mock-kabu2
ExecStart=/usr/bin/docker compose --env-file deploy/production/.env.production -f deploy/production/compose.production.yml -f deploy/oci/compose.oci.yml run --rm api oracle-sync
