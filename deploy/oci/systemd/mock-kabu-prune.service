[Unit]
Description=mock-kabu2 weekly bot-history prune + consistency check
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/mock-kabu2
ExecStart=/usr/bin/docker compose --env-file deploy/production/.env.production -f deploy/production/compose.production.yml -f deploy/oci/compose.oci.yml run --rm api prune-history --apply --compact-bot-ledger
ExecStartPost=/usr/bin/docker compose --env-file deploy/production/.env.production -f deploy/production/compose.production.yml -f deploy/oci/compose.oci.yml run --rm api consistency
