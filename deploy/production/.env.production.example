# Copy to .env.production on the VPS. Values here are deliberately non-secret examples.
# Use only URL-safe hexadecimal secrets because POSTGRES_PASSWORD and REDIS_PASSWORD are
# assembled into connection URLs by Compose.
COMPOSE_PROJECT_NAME=mock-kabu2-prod
APP_IMAGE=mock-kabu2-app:production

# Public HTTPS endpoint. Point an A/AAAA record here before the first Caddy start.
APP_DOMAIN=exchange.example.com
CADDY_EMAIL=ops@example.com

# PostgreSQL cluster. Do not reuse the local-development credentials.
POSTGRES_USER=mock_kabu
POSTGRES_PASSWORD=replace_with_a_64_character_hex_postgres_password
POSTGRES_DB=mock_kabu2

# Redis is private to the Docker network, but still requires a separate password.
REDIS_PASSWORD=replace_with_a_64_character_hex_redis_password
# Stream retention trims only ACKed records; this is the explicit in-memory
# ceiling, not a permission to evict an unprocessed order or settlement event.
REDIS_MAXMEMORY=256mb

# Application secrets. Generate each independently (for example: openssl rand -hex 32).
JWT_SECRET=replace_with_a_64_character_hex_jwt_secret
LIQUIDITY_BOOTSTRAP_TOKEN=replace_with_a_64_character_hex_liquidity_token
# Seeded administrator and bot credentials. These are intentionally separate
# from JWT_SECRET and must not keep the local-development defaults.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_private_admin_password
BOT_PASSWORD=replace_with_a_private_bot_password
LIQUIDITY_BOT_PASSWORD=replace_with_a_private_liquidity_bot_password

# 봇 부하 조절 (선택). 마켓메이커 호가 재조정 주기(ms, 기본 500 — 로컬 개발은 250)와
# 흐름 봇 대기시간 배율(기본 1.2 — 1이면 로컬과 같은 활기, 2면 절반 속도).
# vCPU 1개짜리 VPS에서 api/postgres CPU가 계속 높으면 1000 / 2로 올린다.
BOT_QUOTE_RECONCILE_MS=500
BOT_FLOW_DELAY_SCALE=1.2

# --- Cloud VM overlay (deploy/gcp or deploy/oci) ---
# APP_ORIGIN=https://kabu.example.com        # 도메인이 없으면 http://공인IP 와 APP_DOMAIN=localhost
# CADDYFILE=../production/Caddyfile          # IP + HTTP 모드면 ../gcp/Caddyfile.http

# --- Oracle Cloud (deploy/oci) 에서만 쓰는 값 — deploy/oci/README.md 참고 ---
# PGBACKREST_CONF=../oci/pgbackrest.s3.conf  # 백업을 Object Storage로 보낼 때
# OCI_S3_ACCESS_KEY=
# OCI_S3_SECRET_KEY=
# ORACLE_ORDS_URL=https://xxxx-mockkabu.adb.ap-chuncheon-1.oraclecloudapps.com/ords/mockkabu
# ORACLE_DB_USER=MOCKKABU
# ORACLE_DB_PASSWORD=

# PostgreSQL backup repository encryption key. Losing this key makes backups unusable.
PGBACKREST_REPO1_CIPHER_PASS=replace_with_a_64_character_hex_backup_key

# optimistic | pessimistic | distributed
LOCK_STRATEGY=pessimistic
