[Unit]
Description=mock-kabu2 daily history prune + consistency check
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/mock-kabu2
ExecStart=/usr/bin/docker compose --env-file deploy/production/.env.production -f deploy/production/compose.production.yml -f deploy/gcp/compose.gcp.yml run --rm --no-deps api prune-history --apply --compact-bot-ledger --orders-days 3 --trades-days 14 --ledger-days 3
ExecStartPost=/usr/bin/docker compose --env-file deploy/production/.env.production -f deploy/production/compose.production.yml -f deploy/gcp/compose.gcp.yml run --rm --no-deps api consistency
