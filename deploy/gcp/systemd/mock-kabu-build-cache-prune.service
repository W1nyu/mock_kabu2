[Unit]
Description=Prune unused mock-kabu build cache, old rollback tags and dangling images
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker builder prune -af --reserved-space 2GB
WorkingDirectory=/opt/mock-kabu2
ExecStartPost=/bin/sh scripts/ops/prune-rollback-images.sh 8
