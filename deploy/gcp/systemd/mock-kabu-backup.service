[Unit]
Description=mock-kabu2 pgBackRest backup (diff every six hours, full daily)
After=docker.service
StartLimitIntervalSec=2h
StartLimitBurst=3

[Service]
Type=oneshot
Restart=on-failure
RestartSec=15min
TimeoutStartSec=30min
WorkingDirectory=/opt/mock-kabu2
ExecStart=/bin/sh -c 'if [ "$(TZ=Asia/Seoul date +%%H)" = 03 ]; then TYPE=full; else TYPE=diff; fi; docker compose --env-file deploy/production/.env.production -f deploy/production/compose.production.yml -f deploy/gcp/compose.gcp.yml exec -T -u postgres postgres pgbackrest --stanza=mock-kabu --type=$TYPE backup'
