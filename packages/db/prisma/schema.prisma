generator client {
  provider = "prisma-client-js"
  // 이미지를 x86 PC에서 빌드해 Oracle Cloud A1(ARM) VM으로 옮겨도 엔진이 있도록 두 리눅스 타깃을 함께 생성한다.
  // VM 위에서 직접 빌드하면 native만으로 충분하지만 비용은 엔진 파일 두 개뿐이다.
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "account", "order", "matching", "market"]
}

// ── auth ──────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  passwordHash String   @map("password_hash")
  nickname     String   @unique
  isBot        Boolean  @default(false) @map("is_bot")
  isAdmin      Boolean  @default(false) @map("is_admin")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
  @@schema("auth")
}

// ── account ───────────────────────────────────────────

model Account {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  balance    BigInt   @default(0)
  holdAmount BigInt   @default(0) @map("hold_amount")
  version    Int      @default(0)
  /// 분산 락 fencing token — 뒤처진(락을 잃은) 프로세스의 쓰기를 거부하는 단조 증가 값
  fencingToken BigInt @default(0) @map("fencing_token")
  createdAt  DateTime @default(now()) @map("created_at")

  holdings Holding[]
  ledger   LedgerEntry[]

  @@map("accounts")
  @@schema("account")
}

model Holding {
  id        String @id @default(uuid())
  accountId String @map("account_id")
  symbol    String
  qty       Int    @default(0)
  holdQty   Int    @default(0) @map("hold_qty")
  /// 총 매입원가(원). 평단가 = costBasis / qty. 매수 시 체결금액만큼 증가, 매도 시 비례 차감
  costBasis BigInt @default(0) @map("cost_basis")
  version   Int    @default(0)

  account Account @relation(fields: [accountId], references: [id])

  @@unique([accountId, symbol])
  @@map("holdings")
  @@schema("account")
}

/// append-only 현금 원장: sum(delta) == accounts.balance 가 항상 성립해야 한다
model LedgerEntry {
  id           BigInt   @id @default(autoincrement())
  accountId    String   @map("account_id")
  delta        BigInt
  balanceAfter BigInt   @map("balance_after")
  reason       String // SIGNUP_BONUS | TRANSFER_IN | TRANSFER_OUT | TRADE_BUY | TRADE_SELL | SEED
  refId        String?  @map("ref_id")
  createdAt    DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@map("ledger_entries")
  @@schema("account")
}

/// 관리자 일괄 이체의 재시도 중복 지급 방지 키. 지급과 같은 트랜잭션에 기록한다.
model AdminDistribution {
  requestId      String   @id @map("request_id") @db.Uuid
  accountId      String   @map("account_id")
  amountEach     BigInt   @map("amount_each")
  recipientCount Int      @default(0) @map("recipient_count")
  total          BigInt   @default(0)
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("admin_distributions")
  @@schema("account")
}

/// 매도 체결별 실현손익. 정산 컨슈머가 costBasis 비례 차감과 같은 트랜잭션에 기록한다.
/// realized = 매도 대금 − 차감 원가. 누적 realized + 남은 costBasis = 총 매입원가.
model RealizedPnl {
  id          BigInt   @id @default(autoincrement())
  accountId   String   @map("account_id")
  symbol      String
  /// 매도 체결 ID — 재정산돼도 두 번 기록되지 않는다
  tradeId     String   @unique @map("trade_id")
  qty         Int
  price       Int
  /// 이번 매도로 차감한 매입원가(원)
  costBasis   BigInt   @map("cost_basis")
  /// 실현손익(원) = price × qty − costBasis
  realized    BigInt
  /// 체결 시각 (event ts). KST 당일 집계 기준
  tradedAt    DateTime @map("traded_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([accountId, tradedAt])
  @@index([accountId, symbol])
  @@map("realized_pnl")
  @@schema("account")
}

/// 계좌 자산 스냅샷(1분 단위, 사용자 계정만). API가 매 분 현금+보유평가액을 기록해
/// 대시보드 자산 추이 차트를 그린다. (account_id, ts) 유니크로 다중 인스턴스 중복을 막는다.
model EquitySnapshot {
  id         BigInt   @id @default(autoincrement())
  accountId  String   @map("account_id")
  /// 분 단위로 내린 시각
  ts         DateTime
  cash       BigInt
  stockValue BigInt   @map("stock_value")
  equity     BigInt

  @@unique([accountId, ts])
  @@map("equity_snapshots")
  @@schema("account")
}

/// 이벤트 중복 소비 방지 (정산 멱등성)
model ProcessedEvent {
  eventId     String   @id @map("event_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([processedAt])
  @@map("processed_events")
  @@schema("account")
}

// ── order ─────────────────────────────────────────────

model Order {
  id        String   @id @default(uuid())
  accountId String   @map("account_id")
  symbol    String
  side      String // BUY | SELL
  type      String // LIMIT | MARKET
  price     Int?
  qty       Int
  filledQty Int      @default(0) @map("filled_qty")
  status    String   @default("OPEN") // OPEN | PARTIAL | FILLED | CANCELED | REJECTED
  /// BUY: 홀드한 현금 단가 (LIMIT=지정가, MARKET=추정가). SELL: 0 (수량은 holdings.hold_qty로 홀드)
  holdPerUnit BigInt @default(0) @map("hold_per_unit")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([accountId, createdAt])
  /// Per-symbol OPEN/PARTIAL reconciliation for dedicated market makers.
  @@index([accountId, symbol, status, createdAt])
  @@index([symbol, status])
  @@map("orders")
  @@schema("order")
}

/// 조건부(예약) 주문. 대기 중에는 현금/보유를 홀드하지 않고, 체결가가 조건을 만족하는
/// 순간 API가 WAITING→TRIGGERED로 claim한 뒤 일반 주문을 접수한다 (접수 실패 시 FAILED).
model ConditionalOrder {
  id           String   @id @default(uuid())
  accountId    String   @map("account_id")
  symbol       String
  side         String // BUY | SELL
  /// AT_OR_ABOVE | AT_OR_BELOW — 현재가가 trigger_price 이상/이하가 되면 발동
  direction    String
  triggerPrice Int      @map("trigger_price")
  qty          Int
  /// 발동 시 접수할 주문 유형 (MARKET | LIMIT)
  orderType    String   @map("order_type")
  limitPrice   Int?     @map("limit_price")
  /// OCO(One-Cancels-Other) 짝. 같은 그룹의 한 행이 발동하면 나머지 WAITING 행은 자동 취소
  ocoGroupId   String?  @map("oco_group_id")
  /// 트레일링 스탑 거리(basis points). null이면 고정 트리거. 있으면 trigger_price가 watermark를 따라 움직인다
  trailBps     Int?     @map("trail_bps")
  /// 트레일링 기준 극값 — 매도는 등록 후 고점, 매수는 저점
  watermark    Int?
  status       String   @default("WAITING") // WAITING | TRIGGERED | CANCELED | FAILED
  triggeredOrderId  String?   @map("triggered_order_id")
  triggerTradePrice Int?      @map("trigger_trade_price")
  failReason   String?  @map("fail_reason")
  triggeredAt  DateTime? @map("triggered_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([symbol, status])
  @@index([accountId, createdAt])
  @@index([ocoGroupId])
  @@index([accountId, status])
  @@map("conditional_orders")
  @@schema("order")
}

/// 매수 주문에 붙인 "체결 후 손절/익절 자동 등록" 의도. 주문이 종결되면 API가 체결 평균가 기준으로
/// OCO 조건부 주문을 만들고(ARMED), 체결이 없으면 CANCELED로 닫는다.
model BracketIntent {
  id           String   @id @default(uuid())
  accountId    String   @map("account_id")
  orderId      String   @unique @map("order_id")
  symbol       String
  /// 손절 거리(bps, 체결 평균가 아래)
  stopBps      Int      @map("stop_bps")
  /// 익절 거리(bps, 체결 평균가 위)
  takeBps      Int      @map("take_bps")
  status       String   @default("PENDING") // PENDING | ARMED | CANCELED
  armedQty     Int      @default(0) @map("armed_qty")
  avgFillPrice Int?     @map("avg_fill_price")
  /// 등록된 OCO 그룹 또는 즉시 실행된 주문 ID 등 결과 설명
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([status])
  @@index([accountId, createdAt])
  @@map("bracket_intents")
  @@schema("order")
}

/// Transactional Outbox — orders와 동일 트랜잭션으로 커밋, relayer가 발행
model Outbox {
  eventId     String    @id @map("event_id")
  topic       String
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  @@index([publishedAt, createdAt])
  @@map("outbox")
  @@schema("order")
}

// ── matching ──────────────────────────────────────────

model Trade {
  id              String   @id @default(uuid())
  symbol          String
  price           Int
  qty             Int
  buyOrderId      String   @map("buy_order_id")
  sellOrderId     String   @map("sell_order_id")
  buyerAccountId  String   @map("buyer_account_id")
  sellerAccountId String   @map("seller_account_id")
  takerSide       String   @map("taker_side") // BUY | SELL
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([symbol, createdAt])
  @@index([buyerAccountId, createdAt])
  @@index([sellerAccountId, createdAt])
  @@index([buyOrderId])
  @@index([sellOrderId])
  @@map("trades")
  @@schema("matching")
}

/// matching-engine의 orders stream 중복 소비 방지. Redis Streams와 order outbox는
/// at-least-once이므로, 체결 원장과 같은 DB 트랜잭션에서 event_id를 claim한다.
model MatchingProcessedOrderEvent {
  eventId     String   @id @map("event_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_order_events")
  @@schema("matching")
}

/// 매칭 원장과 같은 트랜잭션으로 기록하는 정산 이벤트 outbox.
/// Redis XADD 전 프로세스가 종료돼도 publishedAt IS NULL 행을 다시 발행할 수 있다.
model MatchingOutboxEvent {
  id          BigInt    @id @default(autoincrement())
  eventId     String    @unique @map("event_id")
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  @@index([publishedAt, id])
  @@map("outbox_events")
  @@schema("matching")
}

model MatchingClosedOrderMarker {
  orderId   String   @id @map("order_id")
  eventId   String   @unique @map("event_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("closed_order_markers")
  @@schema("matching")
}

// ── market ────────────────────────────────────────────

model MarketSymbol {
  symbol       String @id
  name         String
  initialPrice Int    @map("initial_price")
  tickSize     Int    @map("tick_size")
  lastPrice    Int    @map("last_price")
  /// 지수용 발행주식수 (shared SYMBOLS.listedShares와 같음)
  listedShares BigInt @default(0) @map("listed_shares")
  /// 재상장 시각. 이 시각 전 체결은 원장으로만 남고 시세(현재가·기준가·통계·체결 목록)에서는 제외된다.
  listedAt     DateTime? @map("listed_at")

  @@map("symbols")
  @@schema("market")
}

/// 시가총액 가중 지수의 구간. starts_at부터 members를 divisor로 합산한다.
/// 편입 종목이 바뀔 때 새 구간을 넣고, 직전 지수 수준이 이어지도록 divisor를 정한다.
model IndexEpoch {
  startsAt DateTime @id @map("starts_at")
  divisor  Float
  members  String[]

  @@map("index_epochs")
  @@schema("market")
}

/// 관리자 시장 시나리오. starts_at~ends_at 동안 symbols에 direction 쪽 뉴스·주문 흐름을 강화한다.
/// 봇 프로세스만 내부 API로 읽으며 공개 API·소켓에는 절대 노출하지 않는다.
model MarketScenario {
  id         String    @id @default(uuid())
  symbols    String[]
  /// UP | DOWN
  direction  String
  /// 1 약 · 2 중 · 3 강
  intensity  Int
  startsAt   DateTime  @map("starts_at")
  endsAt     DateTime  @map("ends_at")
  createdBy  String    @map("created_by")
  canceledAt DateTime? @map("canceled_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([endsAt])
  @@map("scenarios")
  @@schema("market")
}

/// 가상 뉴스. sentiment/impact는 봇 가격 모델의 입력이며 공개 API 응답에서는 제외된다.
model NewsItem {
  id             String   @id @default(uuid())
  /// 봇 프로세스가 부여한 식별자. 재시도 시 중복 저장을 막는다.
  externalId     String   @unique @map("external_id")
  /// 종목 뉴스면 심볼, 시장 전체 매크로 뉴스면 null
  symbol         String?
  category       String // CAPITAL | EARNINGS | ANALYST | BUSINESS | RISK | FLOW | MACRO | SEQUEL
  headline       String
  body           String?
  /// POSITIVE | NEGATIVE — 공개 응답에서 제외된다
  sentiment      String
  /// 이벤트 강도 x 100 (20~100). 이 저장소는 정수만 쓰므로 실수 대신 정수 백분율.
  impact         Int
  /// 발표 시점 현재가. 발표 후 실현 등락 계산용 (매크로 뉴스는 null)
  priceAtPublish Int?     @map("price_at_publish")
  /// 후속 보도인 경우 원 기사의 externalId
  parentExternalId String? @map("parent_external_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([symbol, createdAt])
  @@map("news_items")
  @@schema("market")
}

model Candle {
  symbol   String
  interval String // "1m"
  ts       DateTime
  open     Int
  high     Int
  low      Int
  close    Int
  volume   BigInt @default(0)

  @@id([symbol, interval, ts])
  @@map("candles")
  @@schema("market")
}
